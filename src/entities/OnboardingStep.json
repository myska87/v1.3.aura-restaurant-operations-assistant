{
  "name": "OnboardingStep",
  "type": "object",
  "properties": {
    "step_number": {
      "type": "number",
      "description": "Order in onboarding sequence"
    },
    "title": {
      "type": "string",
      "description": "Step title"
    },
    "description": {
      "type": "string",
      "description": "What this step covers"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "video",
        "text",
        "form",
        "quiz",
        "document_upload",
        "acknowledgement"
      ],
      "description": "Type of content in this step"
    },
    "video_url": {
      "type": "string",
      "description": "Video link if applicable"
    },
    "content_text": {
      "type": "string",
      "description": "Text content or instructions"
    },
    "quiz_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "number"
          }
        }
      },
      "description": "Quiz questions if applicable"
    },
    "passing_score": {
      "type": "number",
      "default": 80,
      "description": "Minimum score to pass (%)"
    },
    "required_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Document types needed (e.g., ID, Right to Work)"
    },
    "acknowledgement_text": {
      "type": "string",
      "description": "Text staff must acknowledge"
    },
    "is_mandatory": {
      "type": "boolean",
      "default": true
    },
    "unlocks_after": {
      "type": "number",
      "description": "Previous step that must be completed"
    },
    "estimated_duration_minutes": {
      "type": "number",
      "description": "Expected time to complete"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "step_number",
    "title",
    "content_type"
  ]
}