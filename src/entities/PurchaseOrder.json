{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Auto-generated order number"
    },
    "supplier_id": {
      "type": "string",
      "description": "Supplier reference"
    },
    "supplier_name": {
      "type": "string"
    },
    "supplier_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "in_delivery",
        "delivered_awaiting_check",
        "approved_received",
        "cancelled"
      ],
      "default": "draft"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ingredient_id": {
            "type": "string"
          },
          "ingredient_name": {
            "type": "string"
          },
          "quantity_ordered": {
            "type": "number"
          },
          "quantity_received": {
            "type": "number",
            "default": 0
          },
          "unit": {
            "type": "string"
          },
          "unit_cost": {
            "type": "number"
          },
          "line_total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "order_date": {
      "type": "string",
      "format": "date-time"
    },
    "expected_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "actual_delivery_date": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_notes": {
      "type": "string"
    },
    "delivery_photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "received_by": {
      "type": "string",
      "description": "User email who received delivery"
    },
    "received_by_name": {
      "type": "string",
      "description": "User full name who received delivery"
    },
    "verified_by": {
      "type": "string",
      "description": "User email who verified delivery"
    },
    "verified_by_name": {
      "type": "string",
      "description": "User full name who verified delivery"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When order was sent to supplier"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When supplier confirmed order"
    },
    "in_delivery_at": {
      "type": "string",
      "format": "date-time",
      "description": "When order entered delivery"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When goods arrived"
    },
    "email_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "linked_production_plan_id": {
      "type": "string",
      "description": "If created from production plan"
    },
    "linked_production_plan_name": {
      "type": "string"
    }
  },
  "required": [
    "supplier_id",
    "items"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    }
  }
}