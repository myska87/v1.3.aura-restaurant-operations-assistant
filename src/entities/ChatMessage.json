{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "Chat room reference"
    },
    "room_name": {
      "type": "string",
      "description": "Cached room name"
    },
    "sender_email": {
      "type": "string",
      "description": "Who sent the message"
    },
    "sender_name": {
      "type": "string",
      "description": "Sender's name"
    },
    "message_content": {
      "type": "string",
      "description": "Message text content"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "file",
        "video",
        "system",
        "announcement"
      ],
      "default": "text",
      "description": "Type of message"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "File URLs"
    },
    "parent_message_id": {
      "type": "string",
      "description": "For threaded replies"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of mentioned user emails"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails who read this"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "is_edited": {
      "type": "boolean",
      "default": false
    },
    "edited_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "type": "string",
      "description": "Original language of message"
    },
    "translations": {
      "type": "object",
      "description": "Translated versions of message"
    }
  },
  "required": [
    "room_id",
    "sender_email",
    "message_content",
    "message_type"
  ]
}