{
  "name": "Shift",
  "type": "object",
  "properties": {
    "staff_email": {
      "type": "string",
      "description": "Email of staff member assigned to shift"
    },
    "staff_name": {
      "type": "string",
      "description": "Name of staff member"
    },
    "role": {
      "type": "string",
      "description": "Role during this shift"
    },
    "department": {
      "type": "string",
      "description": "Department for this shift"
    },
    "shift_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the shift"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "opening",
        "mid_shift",
        "closing"
      ],
      "description": "Type of shift"
    },
    "start_time": {
      "type": "string",
      "description": "Shift start time (HH:mm)"
    },
    "end_time": {
      "type": "string",
      "description": "Shift end time (HH:mm)"
    },
    "clock_in_time": {
      "type": "string",
      "format": "date-time",
      "description": "Actual clock in time"
    },
    "clock_out_time": {
      "type": "string",
      "format": "date-time",
      "description": "Actual clock out time"
    },
    "location": {
      "type": "string",
      "description": "Work location"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "in_progress",
        "completed",
        "missed"
      ],
      "default": "draft"
    },
    "linked_checklist_id": {
      "type": "string",
      "description": "Reference to assigned checklist"
    },
    "auto_generated_tasks": {
      "type": "boolean",
      "default": false,
      "description": "Whether tasks were auto-generated for this shift"
    },
    "tasks_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When tasks were auto-generated"
    },
    "notes": {
      "type": "string",
      "description": "Shift notes"
    }
  },
  "required": [
    "staff_email",
    "shift_date",
    "shift_type",
    "start_time",
    "end_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "staff_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}