{
  "name": "Shift",
  "type": "object",
  "properties": {
    "staff_email": {
      "type": "string",
      "description": "Email of staff member assigned to shift"
    },
    "staff_name": {
      "type": "string",
      "description": "Name of staff member"
    },
    "role": {
      "type": "string",
      "description": "Role during this shift"
    },
    "shift_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the shift"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "opening",
        "mid_shift",
        "closing"
      ],
      "description": "Type of shift"
    },
    "start_time": {
      "type": "string",
      "description": "Shift start time (HH:mm)"
    },
    "end_time": {
      "type": "string",
      "description": "Shift end time (HH:mm)"
    },
    "clock_in_time": {
      "type": "string",
      "format": "date-time",
      "description": "Actual clock in time"
    },
    "clock_out_time": {
      "type": "string",
      "format": "date-time",
      "description": "Actual clock out time"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed",
        "missed"
      ],
      "default": "scheduled"
    }
  },
  "required": [
    "staff_email",
    "shift_date",
    "shift_type",
    "start_time",
    "end_time"
  ]
}