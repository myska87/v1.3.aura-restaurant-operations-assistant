{
  "name": "FeatureIdea",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Feature idea title"
    },
    "description": {
      "type": "string",
      "description": "Detailed description"
    },
    "category": {
      "type": "string",
      "enum": [
        "forms",
        "shifts",
        "tasks",
        "menu",
        "inventory",
        "compliance",
        "reports",
        "automation",
        "ai",
        "mobile",
        "integration",
        "other"
      ],
      "description": "Feature category"
    },
    "problem_solved": {
      "type": "string",
      "description": "What problem does this solve?"
    },
    "use_case": {
      "type": "string",
      "description": "Real-world use case example"
    },
    "priority_for_user": {
      "type": "string",
      "enum": [
        "nice_to_have",
        "would_help",
        "very_important",
        "critical"
      ],
      "default": "would_help",
      "description": "How important is this to you?"
    },
    "screenshot_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reference images or mockups"
    },
    "submitter_email": {
      "type": "string",
      "description": "Who submitted the idea"
    },
    "submitter_name": {
      "type": "string",
      "description": "Submitter's name"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "planned",
        "in_development",
        "completed",
        "declined"
      ],
      "default": "submitted",
      "description": "Idea status"
    },
    "votes": {
      "type": "number",
      "default": 0,
      "description": "Number of user votes"
    },
    "voted_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of user emails who voted"
    },
    "admin_response": {
      "type": "string",
      "description": "Admin feedback on the idea"
    },
    "planned_for_version": {
      "type": "string",
      "description": "Which version this will be in"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When feature was completed"
    }
  },
  "required": [
    "title",
    "description",
    "category",
    "submitter_email",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "email": {
          "$exists": true
        }
      }
    },
    "read": {
      "user_condition": {
        "email": {
          "$exists": true
        }
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "submitter_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "submitter_email": "{{user.email}}"
        }
      ]
    }
  }
}