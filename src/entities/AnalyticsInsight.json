{
  "name": "AnalyticsInsight",
  "type": "object",
  "properties": {
    "insight_date": {
      "type": "string",
      "format": "date",
      "description": "Date insight was generated"
    },
    "insight_type": {
      "type": "string",
      "enum": [
        "improvement",
        "warning",
        "achievement",
        "recommendation",
        "trend"
      ],
      "description": "Type of insight"
    },
    "category": {
      "type": "string",
      "enum": [
        "quality",
        "operations",
        "staff",
        "inventory",
        "compliance",
        "performance"
      ],
      "description": "Category of insight"
    },
    "title": {
      "type": "string",
      "description": "Insight headline"
    },
    "message": {
      "type": "string",
      "description": "Detailed insight message"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "positive",
        "warning",
        "critical"
      ],
      "default": "info"
    },
    "metric_name": {
      "type": "string",
      "description": "Which metric triggered this insight"
    },
    "current_value": {
      "type": "number",
      "description": "Current metric value"
    },
    "previous_value": {
      "type": "number",
      "description": "Previous period value"
    },
    "change_percentage": {
      "type": "number",
      "description": "Percentage change"
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "AI-suggested actions"
    },
    "department": {
      "type": "string",
      "description": "Affected department"
    },
    "is_posted_to_feed": {
      "type": "boolean",
      "default": false,
      "description": "Whether posted to EventHub"
    },
    "priority": {
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "description": "Importance ranking (1-10)"
    },
    "auto_generated": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "insight_date",
    "insight_type",
    "category",
    "title",
    "message"
  ]
}