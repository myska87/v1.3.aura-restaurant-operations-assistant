{
  "name": "RegistrationRequest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Full name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone"
    },
    "desired_position": {
      "type": "string",
      "description": "Position applying for"
    },
    "desired_department": {
      "type": "string",
      "description": "Department preference"
    },
    "invitation_code": {
      "type": "string",
      "description": "Invitation code used (optional)"
    },
    "message": {
      "type": "string",
      "description": "Message from applicant"
    },
    "cv_url": {
      "type": "string",
      "description": "CV/Resume file URL"
    },
    "photo_url": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "pending",
      "description": "Request status"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Admin who reviewed"
    },
    "reviewed_by_name": {
      "type": "string",
      "description": "Reviewer name"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Review timestamp"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Why rejected"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal notes"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When submitted"
    }
  },
  "required": [
    "full_name",
    "email",
    "desired_position",
    "status"
  ]
}