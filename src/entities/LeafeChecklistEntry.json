{
  "name": "LeafeChecklistEntry",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "description": "Reference to LeafeChecklistTemplate"
    },
    "template_name": {
      "type": "string",
      "description": "Cached template name"
    },
    "venue_id": {
      "type": "string",
      "description": "Venue where checklist was completed"
    },
    "venue_name": {
      "type": "string",
      "description": "Cached venue name"
    },
    "staff_email": {
      "type": "string",
      "description": "Who completed the checklist"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name"
    },
    "completion_date": {
      "type": "string",
      "format": "date-time",
      "description": "When checklist was completed"
    },
    "due_date": {
      "type": "string",
      "format": "date-time",
      "description": "When checklist was due"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "overdue",
        "failed"
      ],
      "default": "not_started"
    },
    "task_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "na",
              "pending"
            ]
          },
          "photo_url": {
            "type": "string"
          },
          "temperature_value": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "signature_url": {
      "type": "string",
      "description": "Digital signature image"
    },
    "score": {
      "type": "number",
      "description": "Score achieved (0-100)"
    },
    "total_possible_score": {
      "type": "number",
      "description": "Maximum possible score"
    },
    "percentage": {
      "type": "number",
      "description": "Percentage score"
    },
    "was_on_time": {
      "type": "boolean",
      "description": "Completed before due date"
    },
    "lateness_hours": {
      "type": "number",
      "description": "Hours late if overdue"
    },
    "comments": {
      "type": "string",
      "description": "Additional notes"
    },
    "corrective_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Actions taken for failed items"
    }
  },
  "required": [
    "template_id",
    "venue_id",
    "staff_email",
    "status"
  ]
}