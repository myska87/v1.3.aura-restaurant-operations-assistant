{
  "name": "SOPSignatureLog",
  "type": "object",
  "properties": {
    "sop_id": {
      "type": "string",
      "description": "Reference to SOPDocument"
    },
    "sop_title": {
      "type": "string",
      "description": "Cached SOP title"
    },
    "sop_version": {
      "type": "number",
      "description": "Version signed"
    },
    "staff_id": {
      "type": "string",
      "description": "Reference to User"
    },
    "staff_email": {
      "type": "string",
      "description": "Staff email"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff full name"
    },
    "role": {
      "type": "string",
      "description": "Staff role at time of signing"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When signed"
    },
    "shift_id": {
      "type": "string",
      "description": "Related shift if applicable"
    },
    "confirmation_text": {
      "type": "string",
      "description": "Acknowledgment text (e.g., 'I have read and understood')"
    },
    "digital_signature_url": {
      "type": "string",
      "description": "Digital signature image"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address for audit trail"
    },
    "device_info": {
      "type": "string",
      "description": "Device used for signing"
    },
    "completion_time_minutes": {
      "type": "number",
      "description": "How long they spent on the SOP"
    },
    "quiz_score": {
      "type": "number",
      "description": "Quiz score if SOP includes quiz"
    },
    "notes": {
      "type": "string",
      "description": "Additional staff notes"
    }
  },
  "required": [
    "sop_id",
    "staff_email",
    "signed_at"
  ]
}