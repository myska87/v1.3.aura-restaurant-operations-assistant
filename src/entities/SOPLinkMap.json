{
  "name": "SOPLinkMap",
  "type": "object",
  "properties": {
    "sop_id": {
      "type": "string",
      "description": "Reference to SOPDocument"
    },
    "sop_title": {
      "type": "string",
      "description": "Cached SOP title"
    },
    "linked_entity": {
      "type": "string",
      "enum": [
        "menu_item",
        "form_template",
        "checklist",
        "training_module",
        "equipment",
        "supplier",
        "recipe"
      ],
      "description": "Type of entity being linked"
    },
    "linked_id": {
      "type": "string",
      "description": "ID of the linked record"
    },
    "linked_name": {
      "type": "string",
      "description": "Name of linked record"
    },
    "link_type": {
      "type": "string",
      "enum": [
        "preparation",
        "training",
        "reference",
        "compliance",
        "related"
      ],
      "default": "related",
      "description": "Nature of the link"
    },
    "created_by": {
      "type": "string",
      "description": "Who created this link"
    },
    "created_by_name": {
      "type": "string",
      "description": "Creator name"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether link is active"
    }
  },
  "required": [
    "sop_id",
    "linked_entity",
    "linked_id"
  ]
}