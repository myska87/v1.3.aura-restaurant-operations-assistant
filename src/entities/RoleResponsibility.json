{
  "name": "RoleResponsibility",
  "type": "object",
  "properties": {
    "position": {
      "type": "string",
      "enum": [
        "manager",
        "chef",
        "line_cook",
        "server",
        "bartender",
        "cleaner",
        "maintenance"
      ],
      "description": "Position title"
    },
    "department": {
      "type": "string",
      "enum": [
        "kitchen",
        "front_of_house",
        "bar",
        "management",
        "cleaning",
        "maintenance"
      ],
      "description": "Department"
    },
    "daily_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "estimated_minutes": {
            "type": "number"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "default": "medium"
          },
          "requires_photo": {
            "type": "boolean",
            "default": false
          },
          "linked_form_id": {
            "type": "string"
          }
        }
      },
      "description": "List of daily responsibilities"
    },
    "weekly_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "day_of_week": {
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          },
          "estimated_minutes": {
            "type": "number"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "default": "medium"
          },
          "requires_photo": {
            "type": "boolean",
            "default": false
          },
          "linked_form_id": {
            "type": "string"
          }
        }
      },
      "description": "List of weekly responsibilities"
    },
    "monthly_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "day_of_month": {
            "type": "number"
          },
          "estimated_minutes": {
            "type": "number"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "default": "medium"
          },
          "requires_photo": {
            "type": "boolean",
            "default": false
          },
          "linked_form_id": {
            "type": "string"
          }
        }
      },
      "description": "List of monthly responsibilities"
    },
    "key_skills_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Skills needed for this role"
    },
    "assigned_manager": {
      "type": "string",
      "description": "Manager responsible for this role"
    },
    "auto_assign_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable automatic task assignment for this role"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "position",
    "department"
  ]
}