{
  "name": "AgentInsight",
  "type": "object",
  "properties": {
    "agent_name": {
      "type": "string",
      "description": "AI agent that generated insight"
    },
    "insight_title": {
      "type": "string",
      "description": "Brief insight title"
    },
    "insight_description": {
      "type": "string",
      "description": "Detailed insight"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "is_actionable": {
      "type": "boolean",
      "default": false,
      "description": "Whether insight requires action"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "viewed",
        "acknowledged",
        "resolved"
      ],
      "default": "new"
    },
    "viewed_by": {
      "type": "string",
      "description": "User who viewed"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "agent_name",
    "insight_title",
    "created_at",
    "status"
  ]
}