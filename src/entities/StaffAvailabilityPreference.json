{
  "name": "StaffAvailabilityPreference",
  "type": "object",
  "properties": {
    "staff_email": {
      "type": "string",
      "description": "Staff member email"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name"
    },
    "week_start_date": {
      "type": "string",
      "format": "date",
      "description": "Start of week for these preferences"
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day_of_week": {
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          },
          "is_available": {
            "type": "boolean",
            "default": true
          },
          "preferred_shift_type": {
            "type": "string",
            "enum": [
              "opening",
              "mid_shift",
              "closing",
              "any"
            ]
          },
          "available_from": {
            "type": "string",
            "description": "Time available from (HH:mm)"
          },
          "available_until": {
            "type": "string",
            "description": "Time available until (HH:mm)"
          },
          "max_hours_this_day": {
            "type": "number",
            "description": "Maximum hours willing to work this day"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes (e.g., 'Doctor appointment at 2 PM')"
          }
        }
      },
      "description": "Day-by-day availability preferences"
    },
    "max_hours_this_week": {
      "type": "number",
      "description": "Maximum hours willing to work this week"
    },
    "preferred_days_off": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Preferred days off"
    },
    "cannot_work_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Staff members they cannot work with (conflict resolution)"
    },
    "prefer_work_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Staff members they prefer to work with"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "rejected"
      ],
      "default": "draft"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Manager who reviewed"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Why preferences were rejected"
    },
    "notes_to_manager": {
      "type": "string",
      "description": "Staff notes to manager"
    },
    "manager_notes": {
      "type": "string",
      "description": "Manager notes about these preferences"
    }
  },
  "required": [
    "staff_email",
    "week_start_date",
    "preferences",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "staff_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "staff_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "$and": [
            {
              "staff_email": "{{user.email}}"
            },
            {
              "status": "draft"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "staff_email": "{{user.email}}"
        }
      ]
    }
  }
}