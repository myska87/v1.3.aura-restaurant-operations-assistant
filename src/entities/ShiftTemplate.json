{
  "name": "ShiftTemplate",
  "type": "object",
  "properties": {
    "template_name": {
      "type": "string",
      "description": "Name of the shift template"
    },
    "description": {
      "type": "string",
      "description": "Template description and purpose"
    },
    "template_type": {
      "type": "string",
      "enum": [
        "weekly",
        "weekend",
        "special_event",
        "holiday",
        "custom"
      ],
      "default": "weekly"
    },
    "shifts_config": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day_of_week": {
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          },
          "role": {
            "type": "string",
            "description": "Position/role for this shift"
          },
          "department": {
            "type": "string",
            "enum": [
              "kitchen",
              "front_of_house",
              "bar",
              "management",
              "cleaning",
              "maintenance"
            ]
          },
          "shift_type": {
            "type": "string",
            "enum": [
              "opening",
              "mid_shift",
              "closing"
            ]
          },
          "start_time": {
            "type": "string",
            "description": "Shift start time (HH:mm)"
          },
          "end_time": {
            "type": "string",
            "description": "Shift end time (HH:mm)"
          },
          "staff_count": {
            "type": "number",
            "default": 1
          },
          "preferred_staff_emails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default_tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "task_name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "priority": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "estimated_minutes": {
                  "type": "number"
                }
              }
            },
            "description": "Auto-assigned tasks for this shift"
          },
          "linked_sop_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Auto-linked SOP documents"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "total_shifts": {
      "type": "number"
    },
    "total_hours": {
      "type": "number"
    },
    "estimated_cost": {
      "type": "number"
    },
    "created_by": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "last_used": {
      "type": "string",
      "format": "date-time"
    },
    "times_used": {
      "type": "number",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "template_name",
    "template_type",
    "shifts_config",
    "created_by"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    }
  }
}