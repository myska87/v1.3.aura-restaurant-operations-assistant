{
  "name": "InventoryIngredient",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Ingredient name"
    },
    "category": {
      "type": "string",
      "enum": [
        "produce",
        "meat",
        "seafood",
        "dairy",
        "dry_goods",
        "spices",
        "beverages",
        "packaging",
        "cleaning",
        "other"
      ],
      "description": "Ingredient category"
    },
    "unit": {
      "type": "string",
      "description": "Base unit (kg, g, liters, pieces, etc.)"
    },
    "current_stock": {
      "type": "number",
      "default": 0,
      "description": "Current quantity in stock"
    },
    "par_level": {
      "type": "number",
      "description": "Ideal stock level"
    },
    "reorder_point": {
      "type": "number",
      "description": "When to reorder"
    },
    "supplier_id": {
      "type": "string",
      "description": "Primary supplier ID - REQUIRED for auto-ordering"
    },
    "supplier_name": {
      "type": "string",
      "description": "Cached supplier name"
    },
    "supplier_email": {
      "type": "string",
      "description": "Cached supplier email"
    },
    "supplier_phone": {
      "type": "string",
      "description": "Cached supplier phone"
    },
    "unit_cost": {
      "type": "number",
      "description": "Cost per unit from supplier"
    },
    "pack_size": {
      "type": "string",
      "description": "How supplier sells it (e.g., 2kg pack)"
    },
    "storage_location": {
      "type": "string",
      "description": "Where stored (Fridge A, Dry Store, etc.)"
    },
    "shelf_life_days": {
      "type": "number",
      "description": "Days until expiry after opening"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Expiration date for current stock"
    },
    "allergen_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "milk",
          "nuts",
          "gluten",
          "soy",
          "egg",
          "fish",
          "shellfish",
          "sesame",
          "celery",
          "mustard",
          "sulphites",
          "lupin"
        ]
      },
      "description": "Allergens contained in this ingredient"
    },
    "auto_order_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable automatic ordering when below reorder point"
    },
    "auto_order_quantity": {
      "type": "number",
      "description": "Fixed quantity to order, or null to order to par level"
    },
    "last_cost_update": {
      "type": "string",
      "format": "date",
      "description": "When unit_cost was last updated"
    },
    "last_ordered": {
      "type": "string",
      "format": "date",
      "description": "Last order date"
    },
    "minimum_quantity": {
      "type": "number",
      "description": "Minimum stock alert threshold (legacy - use reorder_point)"
    },
    "supplier_contact": {
      "type": "string",
      "description": "Supplier contact info (legacy - use supplier_phone)"
    }
  },
  "required": [
    "name",
    "category",
    "unit",
    "unit_cost",
    "supplier_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "user_condition": {
            "position": "chef"
          }
        },
        {
          "user_condition": {
            "position": "sous_chef"
          }
        },
        {
          "user_condition": {
            "position": "line_cook"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}