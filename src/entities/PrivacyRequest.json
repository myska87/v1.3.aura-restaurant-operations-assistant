{
  "name": "PrivacyRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User making the request"
    },
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "user_name": {
      "type": "string",
      "description": "User full name"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "data_export",
        "data_deletion",
        "data_correction",
        "access_restriction",
        "data_portability",
        "consent_withdrawal"
      ],
      "description": "Type of privacy request"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "rejected",
        "cancelled"
      ],
      "default": "pending",
      "description": "Request status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "urgent"
      ],
      "default": "normal",
      "description": "Request priority"
    },
    "request_details": {
      "type": "string",
      "description": "Additional details about the request"
    },
    "response_data": {
      "type": "object",
      "description": "Response details or export data metadata"
    },
    "export_file_url": {
      "type": "string",
      "description": "Secure URL for exported data"
    },
    "export_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When export link expires"
    },
    "handled_by": {
      "type": "string",
      "description": "Admin who handled request"
    },
    "handled_by_name": {
      "type": "string",
      "description": "Admin name"
    },
    "handled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When request was completed"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason if rejected"
    },
    "legal_basis": {
      "type": "string",
      "description": "Legal basis for handling"
    },
    "response_time_hours": {
      "type": "number",
      "description": "Time taken to respond"
    },
    "notification_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether user was notified of completion"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "request_type",
    "status"
  ]
}