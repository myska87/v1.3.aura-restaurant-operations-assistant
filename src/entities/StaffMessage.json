{
  "name": "StaffMessage",
  "type": "object",
  "properties": {
    "sender_email": {
      "type": "string",
      "description": "Who sent the message"
    },
    "sender_name": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string",
      "description": "Who receives (or 'all' for broadcast)"
    },
    "recipient_name": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "direct",
        "team",
        "department",
        "announcement"
      ],
      "description": "Type of message"
    },
    "subject": {
      "type": "string",
      "description": "Message subject"
    },
    "content": {
      "type": "string",
      "description": "Message body"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "File URLs"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "sender_email",
    "recipient_email",
    "content"
  ]
}