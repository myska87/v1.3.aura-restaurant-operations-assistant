{
  "name": "HygieneUserScore",
  "type": "object",
  "properties": {
    "staff_email": {
      "type": "string",
      "description": "Staff member email"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name"
    },
    "venue_id": {
      "type": "string",
      "description": "Primary venue"
    },
    "total_points": {
      "type": "number",
      "default": 0,
      "description": "Total hygiene points earned"
    },
    "points_this_week": {
      "type": "number",
      "default": 0,
      "description": "Points earned this week"
    },
    "points_this_month": {
      "type": "number",
      "default": 0,
      "description": "Points earned this month"
    },
    "total_records": {
      "type": "number",
      "default": 0,
      "description": "Total records submitted"
    },
    "records_on_time": {
      "type": "number",
      "default": 0,
      "description": "Records submitted on time"
    },
    "records_with_photo": {
      "type": "number",
      "default": 0,
      "description": "Records with photo evidence"
    },
    "variance_alerts_count": {
      "type": "number",
      "default": 0,
      "description": "Number of out-of-range readings"
    },
    "corrective_actions_taken": {
      "type": "number",
      "default": 0,
      "description": "Proactive corrections made"
    },
    "badges_earned": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "badge_id": {
            "type": "string"
          },
          "badge_name": {
            "type": "string"
          },
          "badge_icon": {
            "type": "string"
          },
          "earned_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Achievement badges collected"
    },
    "current_streak": {
      "type": "number",
      "default": 0,
      "description": "Consecutive days with perfect records"
    },
    "longest_streak": {
      "type": "number",
      "default": 0,
      "description": "Best streak ever achieved"
    },
    "compliance_rate": {
      "type": "number",
      "description": "Percentage of records within safe range"
    },
    "rank_in_venue": {
      "type": "number",
      "description": "Leaderboard position in venue"
    },
    "rank_global": {
      "type": "number",
      "description": "Leaderboard position globally"
    },
    "last_record_date": {
      "type": "string",
      "format": "date-time"
    },
    "achievements_unlocked": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of achievement IDs"
    }
  },
  "required": [
    "staff_email"
  ]
}