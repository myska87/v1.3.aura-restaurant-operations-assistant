{
  "name": "FormHistory",
  "type": "object",
  "properties": {
    "form_id": {
      "type": "string",
      "description": "Reference to FormTemplate"
    },
    "form_name": {
      "type": "string",
      "description": "Cached form name"
    },
    "version_number": {
      "type": "number",
      "description": "Version number"
    },
    "fields_snapshot": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Complete fields configuration at this version"
    },
    "changes_made": {
      "type": "string",
      "description": "Summary of changes in this version"
    },
    "edited_by": {
      "type": "string",
      "description": "User who made the edit"
    },
    "edited_by_name": {
      "type": "string",
      "description": "User name"
    },
    "previous_version": {
      "type": "number",
      "description": "Previous version number"
    },
    "is_rollback": {
      "type": "boolean",
      "default": false,
      "description": "Whether this was a rollback to previous version"
    }
  },
  "required": [
    "form_id",
    "version_number",
    "fields_snapshot",
    "edited_by"
  ]
}