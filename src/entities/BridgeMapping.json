{
  "name": "BridgeMapping",
  "type": "object",
  "properties": {
    "mapping_name": {
      "type": "string",
      "description": "Descriptive name for this mapping"
    },
    "source_module": {
      "type": "string",
      "description": "Source module name"
    },
    "source_entity": {
      "type": "string",
      "description": "Source entity/table name"
    },
    "target_module": {
      "type": "string",
      "description": "Target module name"
    },
    "target_entity": {
      "type": "string",
      "description": "Target entity/table name"
    },
    "field_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_field": {
            "type": "string"
          },
          "target_field": {
            "type": "string"
          },
          "transform": {
            "type": "string",
            "description": "Transformation function name if needed"
          }
        }
      },
      "description": "Field-level mappings"
    },
    "sync_frequency": {
      "type": "string",
      "enum": [
        "realtime",
        "hourly",
        "daily",
        "manual"
      ],
      "default": "realtime",
      "description": "How often to sync"
    },
    "sync_direction": {
      "type": "string",
      "enum": [
        "one_way",
        "two_way"
      ],
      "default": "one_way",
      "description": "Data flow direction"
    },
    "filter_conditions": {
      "type": "object",
      "description": "Conditions for which records to sync"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "description": "Who created this mapping"
    }
  },
  "required": [
    "mapping_name",
    "source_module",
    "source_entity",
    "target_module",
    "target_entity"
  ]
}