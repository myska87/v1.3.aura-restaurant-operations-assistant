{
  "name": "MeetingRecording",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Meeting title (auto-generated or manual)"
    },
    "description": {
      "type": "string",
      "description": "Meeting description or purpose"
    },
    "audio_url": {
      "type": "string",
      "description": "Secure URL to audio file"
    },
    "audio_duration_seconds": {
      "type": "number",
      "description": "Duration of recording in seconds"
    },
    "transcribed_text": {
      "type": "string",
      "description": "Full AI-generated transcript"
    },
    "speaker_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "speaker_id": {
            "type": "string"
          },
          "speaker_name": {
            "type": "string"
          },
          "start_time": {
            "type": "number"
          },
          "end_time": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "description": "Diarized speaker segments"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated meeting summary"
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Main discussion points"
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "assigned_to": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "urgent"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "cancelled"
            ],
            "default": "pending"
          },
          "linked_task_id": {
            "type": "string"
          }
        }
      },
      "description": "Detected action items from meeting"
    },
    "topics_discussed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "AI-detected topics (hygiene, hr, shift, supplies, etc.)"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "concerned",
        "urgent"
      ],
      "default": "neutral",
      "description": "Overall meeting sentiment"
    },
    "department": {
      "type": "string",
      "enum": [
        "all",
        "kitchen",
        "front_of_house",
        "bar",
        "management",
        "cleaning",
        "maintenance"
      ],
      "default": "all",
      "description": "Department this meeting relates to"
    },
    "meeting_type": {
      "type": "string",
      "enum": [
        "daily_briefing",
        "shift_handover",
        "safety_meeting",
        "performance_review",
        "planning",
        "training",
        "other"
      ],
      "description": "Type of meeting"
    },
    "status": {
      "type": "string",
      "enum": [
        "recording",
        "processing",
        "transcribing",
        "summarizing",
        "pending_review",
        "approved",
        "archived"
      ],
      "default": "recording",
      "description": "Current processing status"
    },
    "processing_progress": {
      "type": "number",
      "default": 0,
      "description": "Progress percentage (0-100)"
    },
    "created_by": {
      "type": "string",
      "description": "Manager who recorded meeting"
    },
    "created_by_name": {
      "type": "string",
      "description": "Manager name"
    },
    "meeting_date": {
      "type": "string",
      "format": "date-time",
      "description": "When meeting took place"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Who reviewed/approved notes"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When notes were approved"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Version number of notes"
    },
    "edit_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "edited_by": {
            "type": "string"
          },
          "edited_at": {
            "type": "string",
            "format": "date-time"
          },
          "changes": {
            "type": "string"
          }
        }
      },
      "description": "History of edits to notes"
    },
    "is_confidential": {
      "type": "boolean",
      "default": false,
      "description": "Whether meeting contains sensitive information"
    },
    "auto_delete_audio": {
      "type": "boolean",
      "default": false,
      "description": "Delete raw audio after transcription"
    },
    "audio_deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When audio was deleted"
    },
    "linked_shift_id": {
      "type": "string",
      "description": "Reference to related shift"
    },
    "linked_venue_id": {
      "type": "string",
      "description": "Reference to venue if applicable"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Custom tags for organization"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional files or documents"
    }
  },
  "required": [
    "title",
    "meeting_date",
    "created_by",
    "status"
  ]
}