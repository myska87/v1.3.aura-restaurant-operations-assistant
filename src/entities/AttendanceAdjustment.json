{
  "name": "AttendanceAdjustment",
  "type": "object",
  "properties": {
    "attendance_record_id": {
      "type": "string",
      "description": "Reference to AttendanceRecord"
    },
    "staff_email": {
      "type": "string",
      "description": "Staff member requesting adjustment"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name"
    },
    "adjustment_type": {
      "type": "string",
      "enum": [
        "missing_clock_in",
        "missing_clock_out",
        "incorrect_time",
        "technical_issue",
        "forgot_to_clock",
        "other"
      ],
      "description": "Type of adjustment requested"
    },
    "requested_clock_in": {
      "type": "string",
      "format": "date-time",
      "description": "Requested clock in time"
    },
    "requested_clock_out": {
      "type": "string",
      "format": "date-time",
      "description": "Requested clock out time"
    },
    "reason": {
      "type": "string",
      "description": "Detailed reason for adjustment"
    },
    "evidence_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Supporting documents/photos"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "manager_email": {
      "type": "string",
      "description": "Manager who reviewed"
    },
    "manager_name": {
      "type": "string",
      "description": "Manager name"
    },
    "manager_notes": {
      "type": "string",
      "description": "Manager's decision notes"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When adjustment was requested"
    }
  },
  "required": [
    "attendance_record_id",
    "staff_email",
    "adjustment_type",
    "reason",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "email": {
          "$exists": true
        }
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "staff_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    }
  }
}