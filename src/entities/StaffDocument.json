{
  "name": "StaffDocument",
  "type": "object",
  "properties": {
    "staff_email": {
      "type": "string",
      "description": "Staff member email"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "id",
        "right_to_work",
        "hygiene_certificate",
        "bank_details",
        "emergency_contact",
        "contract",
        "uniform_receipt",
        "other"
      ],
      "description": "Type of document"
    },
    "document_name": {
      "type": "string",
      "description": "Custom document name"
    },
    "file_url": {
      "type": "string",
      "description": "Document file URL"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by": {
      "type": "string",
      "description": "Manager who verified"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "For documents with expiry (visa, certificates)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected",
        "expired"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "staff_email",
    "document_type",
    "file_url"
  ]
}