{
  "name": "ChatReaction",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string",
      "description": "Reference to chat message"
    },
    "staff_email": {
      "type": "string",
      "description": "Who reacted"
    },
    "staff_name": {
      "type": "string",
      "description": "Name of person who reacted"
    },
    "reaction_type": {
      "type": "string",
      "description": "Emoji or reaction (\ud83d\udc4d, \u2764\ufe0f, \ud83d\udd25, \ud83d\ude04, \ud83c\udf89)"
    }
  },
  "required": [
    "message_id",
    "staff_email",
    "reaction_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "email": {
          "$exists": true
        }
      }
    },
    "read": {
      "user_condition": {
        "email": {
          "$exists": true
        }
      }
    },
    "update": false,
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "staff_email": "{{user.email}}"
        }
      ]
    }
  }
}