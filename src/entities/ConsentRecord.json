{
  "name": "ConsentRecord",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who gave consent"
    },
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "user_name": {
      "type": "string",
      "description": "User full name"
    },
    "consent_type": {
      "type": "string",
      "enum": [
        "terms_of_service",
        "privacy_policy",
        "data_processing",
        "marketing_emails",
        "analytics_tracking",
        "cookies",
        "location_tracking"
      ],
      "description": "Type of consent"
    },
    "consent_version": {
      "type": "string",
      "description": "Version of policy/terms consented to"
    },
    "consent_given": {
      "type": "boolean",
      "default": false,
      "description": "Whether consent was given"
    },
    "consent_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When consent was given/updated"
    },
    "consent_method": {
      "type": "string",
      "enum": [
        "checkbox",
        "signature",
        "verbal_confirmed",
        "implied"
      ],
      "default": "checkbox",
      "description": "How consent was obtained"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address when consent given"
    },
    "device_info": {
      "type": "string",
      "description": "Device information"
    },
    "consent_text": {
      "type": "string",
      "description": "Exact text user agreed to"
    },
    "withdrawal_date": {
      "type": "string",
      "format": "date-time",
      "description": "When consent was withdrawn"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether consent is currently active"
    },
    "parent_consent_required": {
      "type": "boolean",
      "default": false,
      "description": "If parental consent needed (under 16)"
    },
    "parent_email": {
      "type": "string",
      "description": "Parent/guardian email if applicable"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "consent_type",
    "consent_version",
    "consent_given",
    "consent_timestamp"
  ]
}