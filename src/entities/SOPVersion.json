{
  "name": "SOPVersion",
  "type": "object",
  "properties": {
    "sop_id": {
      "type": "string",
      "description": "Reference to SOPDocument"
    },
    "sop_title": {
      "type": "string",
      "description": "Cached SOP title"
    },
    "version_number": {
      "type": "number",
      "description": "Version number"
    },
    "content_snapshot": {
      "type": "object",
      "description": "Complete SOP data at this version"
    },
    "changelog": {
      "type": "string",
      "description": "What changed in this version"
    },
    "updated_by": {
      "type": "string",
      "description": "Who updated"
    },
    "updated_by_name": {
      "type": "string",
      "description": "Updater name"
    },
    "replaced_version": {
      "type": "number",
      "description": "Previous version number"
    },
    "is_current": {
      "type": "boolean",
      "default": true,
      "description": "Is this the current version"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When archived"
    }
  },
  "required": [
    "sop_id",
    "version_number",
    "content_snapshot",
    "updated_by"
  ]
}