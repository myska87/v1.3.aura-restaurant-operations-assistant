{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "description": {
      "type": "string",
      "description": "Document description"
    },
    "file_url": {
      "type": "string",
      "description": "Secure file URL"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "pdf",
        "docx",
        "image",
        "video",
        "other"
      ],
      "description": "Type of file"
    },
    "file_size": {
      "type": "number",
      "description": "File size in bytes"
    },
    "category": {
      "type": "string",
      "enum": [
        "policy",
        "training",
        "hr",
        "compliance",
        "safety",
        "menu",
        "procedure",
        "other"
      ],
      "description": "Document category"
    },
    "department": {
      "type": "string",
      "enum": [
        "all",
        "kitchen",
        "front_of_house",
        "bar",
        "management",
        "cleaning",
        "maintenance"
      ],
      "default": "all",
      "description": "Target department"
    },
    "confidentiality_level": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "default": "internal",
      "description": "Security classification"
    },
    "uploaded_by": {
      "type": "string",
      "description": "Manager who uploaded"
    },
    "uploaded_by_name": {
      "type": "string",
      "description": "Manager name"
    },
    "version_number": {
      "type": "number",
      "default": 1,
      "description": "Current version"
    },
    "is_mandatory": {
      "type": "boolean",
      "default": false,
      "description": "Requires acknowledgment"
    },
    "requires_signature": {
      "type": "boolean",
      "default": false,
      "description": "Requires digital signature"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "When document expires"
    },
    "review_frequency": {
      "type": "string",
      "enum": [
        "none",
        "monthly",
        "quarterly",
        "yearly"
      ],
      "default": "none",
      "description": "How often to review"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Search tags"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Document is active"
    },
    "total_views": {
      "type": "number",
      "default": 0,
      "description": "Total view count"
    },
    "acknowledgment_count": {
      "type": "number",
      "default": 0,
      "description": "Total acknowledgments"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "file_url",
    "category",
    "uploaded_by"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "confidentiality_level": "public"
        },
        {
          "$and": [
            {
              "confidentiality_level": "internal"
            },
            {
              "user_condition": {
                "email": {
                  "$exists": true
                }
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}