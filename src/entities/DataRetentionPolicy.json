{
  "name": "DataRetentionPolicy",
  "type": "object",
  "properties": {
    "policy_name": {
      "type": "string",
      "description": "Name of the retention policy"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "AttendanceRecord",
        "Document",
        "DataAudit",
        "PayrollRecord",
        "ClockEvent",
        "ChatMessage",
        "EmailLog",
        "MaintenanceTicket",
        "ComplianceCheck"
      ],
      "description": "Which entity this policy applies to"
    },
    "retention_days": {
      "type": "number",
      "description": "Number of days to retain data"
    },
    "retention_years": {
      "type": "number",
      "description": "Number of years (for display)"
    },
    "auto_purge_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether to automatically purge old data"
    },
    "last_purge_date": {
      "type": "string",
      "format": "date-time",
      "description": "Last time purge ran"
    },
    "records_purged_count": {
      "type": "number",
      "default": 0,
      "description": "Total records purged"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "legal_basis": {
      "type": "string",
      "description": "Legal reason for retention period"
    },
    "created_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "policy_name",
    "entity_type",
    "retention_days"
  ]
}