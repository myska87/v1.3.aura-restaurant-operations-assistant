{
  "name": "DataRetentionPolicy",
  "type": "object",
  "properties": {
    "policy_name": {
      "type": "string",
      "description": "Policy name"
    },
    "entity_type": {
      "type": "string",
      "description": "Entity this policy applies to"
    },
    "retention_period_days": {
      "type": "number",
      "description": "Days to retain data"
    },
    "retention_basis": {
      "type": "string",
      "enum": [
        "legal_requirement",
        "business_need",
        "user_consent",
        "contract_obligation"
      ],
      "description": "Reason for retention"
    },
    "legal_reference": {
      "type": "string",
      "description": "Legal basis (e.g., HMRC 6 years)"
    },
    "action_after_expiry": {
      "type": "string",
      "enum": [
        "delete",
        "anonymise",
        "archive"
      ],
      "description": "What to do when retention period expires"
    },
    "archive_location": {
      "type": "string",
      "description": "Where archived data is stored"
    },
    "encryption_required": {
      "type": "boolean",
      "default": true,
      "description": "Whether data must be encrypted"
    },
    "approval_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether deletion requires approval"
    },
    "auto_execution": {
      "type": "boolean",
      "default": true,
      "description": "Automatically execute retention policy"
    },
    "last_execution": {
      "type": "string",
      "format": "date-time",
      "description": "Last time policy was executed"
    },
    "records_processed": {
      "type": "number",
      "default": 0,
      "description": "Total records processed"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether policy is active"
    },
    "created_by": {
      "type": "string",
      "description": "Who created the policy"
    },
    "dpo_approved": {
      "type": "boolean",
      "default": false,
      "description": "Data Protection Officer approval"
    }
  },
  "required": [
    "policy_name",
    "entity_type",
    "retention_period_days",
    "action_after_expiry"
  ]
}