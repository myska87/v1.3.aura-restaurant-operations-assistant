{
  "name": "LeafeTempStaff",
  "type": "object",
  "properties": {
    "staff_name": {
      "type": "string",
      "description": "Temporary staff member name"
    },
    "staff_email": {
      "type": "string",
      "description": "Contact email"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone"
    },
    "agency": {
      "type": "string",
      "description": "Recruitment agency name"
    },
    "assigned_venue_id": {
      "type": "string",
      "description": "Current venue assignment"
    },
    "assigned_venue_name": {
      "type": "string",
      "description": "Cached venue name"
    },
    "role": {
      "type": "string",
      "description": "Position (chef, server, cleaner, etc.)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Assignment start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Assignment end date"
    },
    "hygiene_certificate": {
      "type": "string",
      "description": "Certificate URL"
    },
    "hygiene_certificate_expiry": {
      "type": "string",
      "format": "date"
    },
    "right_to_work_verified": {
      "type": "boolean",
      "default": false
    },
    "induction_completed": {
      "type": "boolean",
      "default": false
    },
    "induction_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "terminated",
        "on_hold"
      ],
      "default": "active"
    },
    "hourly_rate": {
      "type": "number",
      "description": "Pay rate"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "created_by": {
      "type": "string",
      "description": "Manager who added them"
    }
  },
  "required": [
    "staff_name",
    "assigned_venue_id",
    "role",
    "start_date"
  ]
}