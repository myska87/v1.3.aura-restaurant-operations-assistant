{
  "name": "LeafePolicyDocument",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "haccp",
        "policy",
        "procedure",
        "certificate",
        "training_material",
        "other"
      ],
      "description": "Type of document"
    },
    "file_url": {
      "type": "string",
      "description": "Document file URL"
    },
    "version": {
      "type": "string",
      "description": "Version number"
    },
    "venue_id": {
      "type": "string",
      "description": "Specific venue or 'all'"
    },
    "venue_name": {
      "type": "string",
      "description": "Cached venue name"
    },
    "assigned_to_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which roles must read this"
    },
    "must_read": {
      "type": "boolean",
      "default": false,
      "description": "Mandatory reading"
    },
    "signature_required": {
      "type": "boolean",
      "default": false,
      "description": "Requires digital signature"
    },
    "uploaded_by": {
      "type": "string",
      "description": "Who uploaded"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "When document expires"
    },
    "review_frequency": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "yearly",
        "none"
      ],
      "default": "yearly"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "next_review_due": {
      "type": "string",
      "format": "date"
    },
    "acknowledgements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "staff_email": {
            "type": "string"
          },
          "staff_name": {
            "type": "string"
          },
          "acknowledged_at": {
            "type": "string",
            "format": "date-time"
          },
          "signature_url": {
            "type": "string"
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "document_type",
    "file_url",
    "version"
  ]
}