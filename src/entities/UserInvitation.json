{
  "name": "UserInvitation",
  "type": "object",
  "properties": {
    "invitation_code": {
      "type": "string",
      "description": "Unique invitation code"
    },
    "invited_email": {
      "type": "string",
      "format": "email",
      "description": "Email address to invite"
    },
    "invited_name": {
      "type": "string",
      "description": "Name of person being invited"
    },
    "invited_position": {
      "type": "string",
      "enum": [
        "manager",
        "chef",
        "sous_chef",
        "line_cook",
        "server",
        "bartender",
        "host",
        "cleaner",
        "maintenance"
      ],
      "description": "Position for new user"
    },
    "invited_department": {
      "type": "string",
      "enum": [
        "management",
        "kitchen",
        "front_of_house",
        "bar",
        "cleaning",
        "maintenance"
      ],
      "description": "Department assignment"
    },
    "invited_by": {
      "type": "string",
      "description": "Manager who sent invitation"
    },
    "invited_by_name": {
      "type": "string",
      "description": "Manager name"
    },
    "invitation_type": {
      "type": "string",
      "enum": [
        "email",
        "qr_code",
        "link"
      ],
      "default": "email",
      "description": "How invitation was sent"
    },
    "qr_code_url": {
      "type": "string",
      "description": "QR code image URL"
    },
    "registration_link": {
      "type": "string",
      "description": "Unique registration link"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "expired",
        "cancelled"
      ],
      "default": "pending",
      "description": "Invitation status"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When invitation expires"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When user accepted"
    },
    "email_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When email was sent"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "invitation_code",
    "invited_email",
    "invited_position",
    "invited_by",
    "status"
  ]
}