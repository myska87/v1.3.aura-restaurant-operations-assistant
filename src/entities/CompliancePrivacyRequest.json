{
  "name": "CompliancePrivacyRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User making request"
    },
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "user_name": {
      "type": "string",
      "description": "User full name"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "data_export",
        "data_deletion",
        "data_correction",
        "access_restriction",
        "consent_withdrawal",
        "marketing_opt_out"
      ],
      "description": "Type of privacy request"
    },
    "request_description": {
      "type": "string",
      "description": "Detailed request from user"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "urgent"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "rejected",
        "cancelled"
      ],
      "default": "pending"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When request was submitted"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "GDPR requires response within 30 days"
    },
    "processed_by": {
      "type": "string",
      "description": "Compliance officer handling request"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completion_notes": {
      "type": "string",
      "description": "Notes on how request was handled"
    },
    "export_file_url": {
      "type": "string",
      "description": "URL to download exported data (if applicable)"
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "email",
        "in_person",
        "document",
        "manager_approval"
      ],
      "description": "How user identity was verified"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Why request was rejected (if applicable)"
    },
    "data_affected": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of data types affected by request"
    },
    "requires_manager_approval": {
      "type": "boolean",
      "default": false
    },
    "manager_approved_by": {
      "type": "string"
    },
    "manager_approved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "request_type",
    "status",
    "requested_at"
  ]
}