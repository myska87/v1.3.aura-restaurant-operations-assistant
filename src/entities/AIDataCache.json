{
  "name": "AIDataCache",
  "type": "object",
  "properties": {
    "cache_date": {
      "type": "string",
      "format": "date",
      "description": "Date of cached data"
    },
    "cache_type": {
      "type": "string",
      "enum": [
        "daily_metrics",
        "weekly_summary",
        "forecast_data",
        "pattern_data"
      ],
      "description": "Type of cached data"
    },
    "data_payload": {
      "type": "object",
      "description": "Aggregated data for AI processing"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this cache expires"
    }
  },
  "required": [
    "cache_date",
    "cache_type",
    "data_payload"
  ]
}