{
  "name": "LeafeVenue",
  "type": "object",
  "properties": {
    "venue_name": {
      "type": "string",
      "description": "Name of the kitchen/venue"
    },
    "venue_code": {
      "type": "string",
      "description": "Unique venue identifier"
    },
    "area": {
      "type": "string",
      "enum": [
        "south_west",
        "north_east",
        "central",
        "london",
        "scotland",
        "wales",
        "other"
      ],
      "description": "Geographic area"
    },
    "address": {
      "type": "string",
      "description": "Full venue address"
    },
    "manager_email": {
      "type": "string",
      "description": "Venue manager email"
    },
    "manager_name": {
      "type": "string",
      "description": "Venue manager name"
    },
    "area_manager_email": {
      "type": "string",
      "description": "Area manager overseeing this venue"
    },
    "contact_phone": {
      "type": "string",
      "description": "Venue contact number"
    },
    "hygiene_rating": {
      "type": "number",
      "description": "Official FSA hygiene rating (0-5)"
    },
    "leafe_score": {
      "type": "number",
      "description": "Internal Leafe hygiene score (0-100)"
    },
    "last_audit_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last inspection"
    },
    "next_audit_due": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled audit"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    },
    "background_image_url": {
      "type": "string",
      "description": "Venue photo for dashboard"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "venue_name",
    "venue_code",
    "area",
    "manager_email"
  ]
}