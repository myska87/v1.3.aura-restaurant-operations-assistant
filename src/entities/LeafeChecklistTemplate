{
  "name": "LeafeChecklistTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Checklist template name"
    },
    "category": {
      "type": "string",
      "enum": [
        "opening",
        "closing",
        "deep_clean",
        "food_prep",
        "fridge_temp",
        "pest_control",
        "delivery_check",
        "waste_disposal",
        "handwashing",
        "other"
      ],
      "description": "Checklist category"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "quarterly",
        "yearly",
        "as_needed"
      ],
      "description": "How often checklist should be completed"
    },
    "venue_id": {
      "type": "string",
      "description": "Specific venue or 'all' for all venues"
    },
    "venue_name": {
      "type": "string",
      "description": "Cached venue name"
    },
    "assigned_role": {
      "type": "string",
      "description": "Which role is responsible (chef, manager, cleaner, etc.)"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "requires_photo": {
            "type": "boolean",
            "default": false
          },
          "requires_signature": {
            "type": "boolean",
            "default": false
          },
          "requires_temperature": {
            "type": "boolean",
            "default": false
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "default": "medium"
          },
          "weight": {
            "type": "number",
            "description": "Weight in score calculation (1-10)",
            "default": 5
          },
          "order": {
            "type": "number"
          }
        }
      }
    },
    "scoring_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this checklist affects hygiene score"
    },
    "total_possible_points": {
      "type": "number",
      "description": "Maximum score for this checklist"
    },
    "created_by": {
      "type": "string",
      "description": "Who created template"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "category",
    "frequency",
    "tasks"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}