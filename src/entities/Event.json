{
  "name": "Event",
  "type": "object",
  "properties": {
    "source_module": {
      "type": "string",
      "enum": [
        "rota",
        "sop",
        "quality",
        "inventory",
        "ai",
        "checklist",
        "form",
        "operations",
        "hygiene",
        "maintenance",
        "payroll",
        "system"
      ],
      "description": "Module that triggered this event"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "task_created",
        "task_completed",
        "task_overdue",
        "checklist_missed",
        "checklist_completed",
        "stock_low",
        "stock_critical",
        "shift_published",
        "shift_missed",
        "shift_started",
        "sop_created",
        "sop_signed",
        "sop_overdue",
        "quality_check_low",
        "quality_check_completed",
        "form_assigned",
        "form_completed",
        "form_overdue",
        "maintenance_urgent",
        "hygiene_alert",
        "payroll_ready",
        "attendance_issue",
        "system_alert",
        "ai_insight",
        "other"
      ],
      "description": "Type of event"
    },
    "title": {
      "type": "string",
      "description": "Event title/headline"
    },
    "message": {
      "type": "string",
      "description": "Detailed event message"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical",
        "success"
      ],
      "default": "info",
      "description": "Event severity level"
    },
    "recipient_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails who should see this"
    },
    "recipient_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Roles who should see this (manager, chef, all)"
    },
    "status": {
      "type": "string",
      "enum": [
        "unread",
        "read",
        "acknowledged",
        "actioned",
        "dismissed"
      ],
      "default": "unread",
      "description": "Event read status"
    },
    "linked_entity_type": {
      "type": "string",
      "description": "Type of related entity (Shift, SOPDocument, etc.)"
    },
    "linked_entity_id": {
      "type": "string",
      "description": "ID of related record"
    },
    "linked_entity_name": {
      "type": "string",
      "description": "Cached name/title of linked entity"
    },
    "action_url": {
      "type": "string",
      "description": "Link to relevant page"
    },
    "auto_action_triggered": {
      "type": "boolean",
      "default": false,
      "description": "Whether automatic action was triggered"
    },
    "auto_action_type": {
      "type": "string",
      "description": "Type of auto action (create_task, send_email, etc.)"
    },
    "auto_action_result": {
      "type": "object",
      "description": "Result of automated action"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_email": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "read_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Who has read this event"
    },
    "acknowledged_by": {
      "type": "string",
      "description": "User who acknowledged the event"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "dismissed_by": {
      "type": "string",
      "description": "User who dismissed the event"
    },
    "dismissed_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "description": "Additional event context data"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When event should auto-archive"
    }
  },
  "required": [
    "source_module",
    "event_type",
    "title",
    "message",
    "severity"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "email": {
          "$exists": true
        }
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "recipient_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "recipient_roles": {
            "$in": [
              "{{user.position}}",
              "all"
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "recipient_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    }
  }
}