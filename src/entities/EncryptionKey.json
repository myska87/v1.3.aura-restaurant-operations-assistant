{
  "name": "EncryptionKey",
  "type": "object",
  "properties": {
    "key_name": {
      "type": "string",
      "description": "Identifier for this key"
    },
    "key_purpose": {
      "type": "string",
      "enum": [
        "pii_encryption",
        "location_tokenisation",
        "signature_encryption",
        "document_encryption"
      ],
      "description": "What this key encrypts"
    },
    "key_hash": {
      "type": "string",
      "description": "Hash of the encryption key (not the key itself)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Key expiry (90 days rotation)"
    },
    "rotation_count": {
      "type": "number",
      "default": 0,
      "description": "How many times key has been rotated"
    },
    "last_rotation_date": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "previous_key_hash": {
      "type": "string",
      "description": "Previous key for backward compatibility"
    },
    "algorithm": {
      "type": "string",
      "default": "AES-256",
      "description": "Encryption algorithm"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "key_name",
    "key_purpose",
    "key_hash",
    "created_at",
    "expires_at"
  ]
}