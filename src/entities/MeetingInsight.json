{
  "name": "MeetingInsight",
  "type": "object",
  "properties": {
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Analysis period start"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "Analysis period end"
    },
    "total_meetings": {
      "type": "number",
      "default": 0,
      "description": "Total meetings recorded"
    },
    "total_duration_hours": {
      "type": "number",
      "default": 0,
      "description": "Total meeting time"
    },
    "avg_duration_minutes": {
      "type": "number",
      "default": 0,
      "description": "Average meeting length"
    },
    "meetings_by_type": {
      "type": "object",
      "description": "Breakdown by meeting type"
    },
    "meetings_by_department": {
      "type": "object",
      "description": "Breakdown by department"
    },
    "top_topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "frequency": {
            "type": "number"
          }
        }
      },
      "description": "Most discussed topics"
    },
    "total_actions_created": {
      "type": "number",
      "default": 0
    },
    "actions_completed": {
      "type": "number",
      "default": 0
    },
    "actions_overdue": {
      "type": "number",
      "default": 0
    },
    "action_completion_rate": {
      "type": "number",
      "description": "Percentage of completed actions"
    },
    "most_active_staff": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "staff_name": {
            "type": "string"
          },
          "meeting_count": {
            "type": "number"
          },
          "speaking_time": {
            "type": "number"
          }
        }
      }
    },
    "sentiment_breakdown": {
      "type": "object",
      "properties": {
        "positive": {
          "type": "number"
        },
        "neutral": {
          "type": "number"
        },
        "concerned": {
          "type": "number"
        },
        "urgent": {
          "type": "number"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "period_start",
    "period_end",
    "total_meetings"
  ]
}