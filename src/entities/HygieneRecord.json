{
  "name": "HygieneRecord",
  "type": "object",
  "properties": {
    "record_type": {
      "type": "string",
      "enum": [
        "delivery",
        "storage_fridge",
        "storage_freezer",
        "cooking",
        "cooling",
        "cleaning",
        "equipment_check",
        "handwash",
        "pest_control"
      ],
      "description": "Type of hygiene record"
    },
    "item_name": {
      "type": "string",
      "description": "Item or area being recorded"
    },
    "recorded_value": {
      "type": "number",
      "description": "Temperature or measurement value"
    },
    "unit": {
      "type": "string",
      "enum": [
        "celsius",
        "fahrenheit",
        "pass_fail",
        "count"
      ],
      "default": "celsius"
    },
    "recommended_min": {
      "type": "number",
      "description": "Minimum safe value"
    },
    "recommended_max": {
      "type": "number",
      "description": "Maximum safe value"
    },
    "is_in_range": {
      "type": "boolean",
      "description": "Whether value is within safe limits"
    },
    "variance_alert": {
      "type": "boolean",
      "default": false,
      "description": "Alert triggered if out of range"
    },
    "recorded_by_email": {
      "type": "string",
      "description": "Staff member who recorded"
    },
    "recorded_by_name": {
      "type": "string",
      "description": "Staff member name"
    },
    "venue_id": {
      "type": "string",
      "description": "Venue/location reference"
    },
    "venue_name": {
      "type": "string",
      "description": "Cached venue name"
    },
    "shift_id": {
      "type": "string",
      "description": "Related shift ID"
    },
    "linked_form_id": {
      "type": "string",
      "description": "Related form from FormIntelligence"
    },
    "linked_checklist_id": {
      "type": "string",
      "description": "Related LeafeCore checklist"
    },
    "photo_url": {
      "type": "string",
      "description": "Evidence photo"
    },
    "signature_url": {
      "type": "string",
      "description": "Verification signature"
    },
    "corrective_action": {
      "type": "string",
      "description": "Action taken if issue found"
    },
    "corrective_action_photo": {
      "type": "string",
      "description": "Photo of corrective action"
    },
    "verified_by_manager": {
      "type": "boolean",
      "default": false
    },
    "verified_by_email": {
      "type": "string",
      "description": "Manager who verified"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string",
      "description": "Specific location (Fridge A, Kitchen 2, etc.)"
    },
    "batch_number": {
      "type": "string",
      "description": "Batch or delivery reference"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Product expiry date if applicable"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "recorded",
        "needs_attention",
        "corrected",
        "verified"
      ],
      "default": "recorded"
    },
    "points_awarded": {
      "type": "number",
      "default": 0,
      "description": "Gamification points earned"
    },
    "is_critical": {
      "type": "boolean",
      "default": false,
      "description": "Critical temperature failure requiring immediate action"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "record_type",
    "item_name",
    "recorded_by_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "recorded_by_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "recorded_by_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "recorded_by_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    }
  }
}