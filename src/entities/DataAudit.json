{
  "name": "DataAudit",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of user who performed action"
    },
    "user_email": {
      "type": "string",
      "description": "Email of user who performed action"
    },
    "user_name": {
      "type": "string",
      "description": "Name of user who performed action"
    },
    "entity_accessed": {
      "type": "string",
      "description": "Entity name accessed (User, Staff, Payroll, etc.)"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "read",
        "create",
        "update",
        "delete",
        "export",
        "view"
      ],
      "description": "Type of action performed"
    },
    "record_id": {
      "type": "string",
      "description": "ID of the record accessed/modified"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When action occurred"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address of user"
    },
    "device_info": {
      "type": "string",
      "description": "Browser/device information"
    },
    "changes_made": {
      "type": "object",
      "description": "What fields were changed (for updates)"
    },
    "access_reason": {
      "type": "string",
      "description": "Why access was needed (optional)"
    },
    "is_sensitive": {
      "type": "boolean",
      "default": false,
      "description": "Whether this was sensitive data access"
    },
    "session_id": {
      "type": "string",
      "description": "User session identifier"
    },
    "location": {
      "type": "string",
      "description": "Geographic location if available"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "entity_accessed",
    "action_type",
    "timestamp"
  ]
}