{
  "name": "DailyChecklist",
  "type": "object",
  "properties": {
    "checklist_type": {
      "type": "string",
      "enum": [
        "opening",
        "closing"
      ],
      "description": "Type of checklist"
    },
    "department": {
      "type": "string",
      "enum": [
        "kitchen",
        "front_of_house",
        "bar",
        "management",
        "cleaning",
        "maintenance"
      ],
      "description": "Department this checklist is for"
    },
    "location": {
      "type": "string",
      "description": "Restaurant location"
    },
    "checklist_date": {
      "type": "string",
      "format": "date",
      "description": "Date of checklist"
    },
    "assigned_staff": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "staff_email": {
            "type": "string"
          },
          "staff_name": {
            "type": "string"
          }
        }
      },
      "description": "Staff assigned to this checklist"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "verified",
        "rejected"
      ],
      "default": "pending",
      "description": "Current status"
    },
    "verified_by_email": {
      "type": "string",
      "description": "Manager who verified"
    },
    "verified_by_name": {
      "type": "string",
      "description": "Manager name"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When verified"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Why checklist was rejected"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "When checklist was started"
    },
    "completed_time": {
      "type": "string",
      "format": "date-time",
      "description": "When all tasks completed"
    },
    "linked_shift_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "References to shifts that triggered this"
    },
    "total_tasks": {
      "type": "number",
      "description": "Total number of tasks"
    },
    "completed_tasks": {
      "type": "number",
      "default": 0,
      "description": "Number of completed tasks"
    },
    "completion_percentage": {
      "type": "number",
      "default": 0,
      "description": "Percentage completed"
    },
    "signature_url": {
      "type": "string",
      "description": "Digital signature"
    },
    "auto_generated": {
      "type": "boolean",
      "default": true,
      "description": "Was this auto-created by system"
    }
  },
  "required": [
    "checklist_type",
    "department",
    "checklist_date",
    "status"
  ]
}