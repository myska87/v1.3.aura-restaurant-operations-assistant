{
  "name": "AnonymisedUser",
  "type": "object",
  "properties": {
    "original_user_id": {
      "type": "string",
      "description": "Original user ID (hashed)"
    },
    "anonymised_id": {
      "type": "string",
      "description": "New anonymised identifier"
    },
    "anonymised_at": {
      "type": "string",
      "format": "date-time",
      "description": "When anonymisation occurred"
    },
    "anonymised_by": {
      "type": "string",
      "description": "Admin who performed anonymisation"
    },
    "reason": {
      "type": "string",
      "enum": [
        "user_request",
        "account_deletion",
        "gdpr_compliance",
        "data_retention"
      ],
      "description": "Why anonymisation was performed"
    },
    "original_email_hash": {
      "type": "string",
      "description": "Hashed original email for reference"
    },
    "data_retained": {
      "type": "object",
      "description": "Anonymised data kept for legal/operational reasons"
    },
    "related_records_count": {
      "type": "number",
      "description": "Number of related records anonymised"
    },
    "verification_code": {
      "type": "string",
      "description": "Code for audit trail verification"
    },
    "ip_address": {
      "type": "string",
      "description": "IP where request originated"
    },
    "legal_hold": {
      "type": "boolean",
      "default": false,
      "description": "Whether data is under legal hold"
    },
    "legal_hold_reason": {
      "type": "string"
    }
  },
  "required": [
    "original_user_id",
    "anonymised_id",
    "anonymised_at",
    "anonymised_by",
    "reason"
  ]
}