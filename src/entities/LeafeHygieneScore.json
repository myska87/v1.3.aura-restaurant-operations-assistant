{
  "name": "LeafeHygieneScore",
  "type": "object",
  "properties": {
    "venue_id": {
      "type": "string",
      "description": "Venue reference"
    },
    "venue_name": {
      "type": "string",
      "description": "Cached venue name"
    },
    "score": {
      "type": "number",
      "description": "Current Leafe hygiene score (0-100)"
    },
    "score_breakdown": {
      "type": "object",
      "properties": {
        "checklist_completion": {
          "type": "number",
          "description": "Points from checklist completion"
        },
        "timeliness": {
          "type": "number",
          "description": "Points from on-time completion"
        },
        "quality": {
          "type": "number",
          "description": "Points from pass rates"
        },
        "audit_results": {
          "type": "number",
          "description": "Points from audit scores"
        }
      }
    },
    "trend_weekly": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "week_start": {
            "type": "string",
            "format": "date"
          },
          "score": {
            "type": "number"
          }
        }
      },
      "description": "Weekly score history"
    },
    "rank_in_area": {
      "type": "number",
      "description": "Ranking within geographic area"
    },
    "rank_globally": {
      "type": "number",
      "description": "Ranking across all venues"
    },
    "area_average": {
      "type": "number",
      "description": "Average score for this area"
    },
    "global_average": {
      "type": "number",
      "description": "Average score across all venues"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "excellent",
        "good",
        "satisfactory",
        "needs_improvement",
        "critical"
      ],
      "description": "Status based on score"
    }
  },
  "required": [
    "venue_id",
    "score"
  ]
}