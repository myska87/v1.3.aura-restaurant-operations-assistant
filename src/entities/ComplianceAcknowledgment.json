{
  "name": "ComplianceAcknowledgment",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Reference to ComplianceDocument"
    },
    "document_title": {
      "type": "string",
      "description": "Cached document title"
    },
    "document_category": {
      "type": "string",
      "description": "Cached category"
    },
    "staff_email": {
      "type": "string",
      "description": "Staff who acknowledged"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name"
    },
    "staff_position": {
      "type": "string",
      "description": "Position at time of acknowledgment"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "description": "When acknowledged"
    },
    "signature_url": {
      "type": "string",
      "description": "Digital signature image"
    },
    "ip_address": {
      "type": "string",
      "description": "IP for audit trail"
    },
    "read_time_seconds": {
      "type": "number",
      "description": "Time spent reading document"
    },
    "quiz_score": {
      "type": "number",
      "description": "Quiz score if document includes quiz"
    },
    "comments": {
      "type": "string",
      "description": "Optional staff comments"
    },
    "verification_code": {
      "type": "string",
      "description": "Unique verification code for this acknowledgment"
    }
  },
  "required": [
    "document_id",
    "staff_email",
    "acknowledged_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "email": {
          "$exists": true
        }
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "staff_email": "{{user.email}}"
        }
      ]
    },
    "update": false,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}