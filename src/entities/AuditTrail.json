{
  "name": "AuditTrail",
  "type": "object",
  "properties": {
    "entity_name": {
      "type": "string",
      "description": "Entity that was modified"
    },
    "record_id": {
      "type": "string",
      "description": "ID of the record"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "view"
      ],
      "description": "Action performed"
    },
    "user_email": {
      "type": "string",
      "description": "User who performed action"
    },
    "user_name": {
      "type": "string",
      "description": "User full name"
    },
    "user_role": {
      "type": "string",
      "description": "User role at time of action"
    },
    "changes": {
      "type": "object",
      "description": "Before/after data"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser/device"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "is_sensitive": {
      "type": "boolean",
      "default": false,
      "description": "Contains sensitive data"
    }
  },
  "required": [
    "entity_name",
    "record_id",
    "action",
    "user_email",
    "timestamp"
  ]
}