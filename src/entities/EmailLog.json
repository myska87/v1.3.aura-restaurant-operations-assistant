{
  "name": "EmailLog",
  "type": "object",
  "properties": {
    "email_type": {
      "type": "string",
      "enum": [
        "purchase_order",
        "supplier_request",
        "notification",
        "alert",
        "confirmation"
      ],
      "description": "Type of email sent"
    },
    "recipient_email": {
      "type": "string",
      "description": "Recipient email address"
    },
    "recipient_name": {
      "type": "string",
      "description": "Recipient name"
    },
    "sender_email": {
      "type": "string",
      "description": "Sender (manager) email"
    },
    "sender_name": {
      "type": "string",
      "description": "Sender name"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "body_html": {
      "type": "string",
      "description": "HTML email body"
    },
    "related_order_id": {
      "type": "string",
      "description": "Reference to PurchaseOrder if applicable"
    },
    "related_document_id": {
      "type": "string",
      "description": "Reference to any related document"
    },
    "attachment_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of attachment URLs"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When email was sent"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "bounced"
      ],
      "default": "pending",
      "description": "Email delivery status"
    },
    "delivery_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When delivery was confirmed"
    },
    "error_message": {
      "type": "string",
      "description": "Error details if failed"
    },
    "retry_count": {
      "type": "number",
      "default": 0,
      "description": "Number of send attempts"
    },
    "metadata": {
      "type": "object",
      "description": "Additional email metadata"
    }
  },
  "required": [
    "email_type",
    "recipient_email",
    "sender_email",
    "subject",
    "body_html",
    "sent_at",
    "status"
  ]
}