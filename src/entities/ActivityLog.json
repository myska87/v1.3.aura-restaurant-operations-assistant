{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "activity_type": {
      "type": "string",
      "enum": [
        "clock_in",
        "clock_out",
        "sop_added",
        "sop_signed",
        "document_uploaded",
        "document_signed",
        "quality_check",
        "checklist_completed",
        "form_submitted",
        "shift_started",
        "shift_completed",
        "task_completed",
        "maintenance_reported",
        "order_created",
        "other"
      ],
      "description": "Type of activity"
    },
    "title": {
      "type": "string",
      "description": "Activity title"
    },
    "description": {
      "type": "string",
      "description": "Activity description"
    },
    "user_email": {
      "type": "string",
      "description": "User who performed the action"
    },
    "user_name": {
      "type": "string",
      "description": "User's full name"
    },
    "icon": {
      "type": "string",
      "description": "Icon identifier for the activity"
    },
    "color": {
      "type": "string",
      "description": "Color theme for activity display",
      "default": "blue"
    },
    "related_entity": {
      "type": "string",
      "description": "Entity type (Shift, SOPDocument, etc.)"
    },
    "related_entity_id": {
      "type": "string",
      "description": "ID of related record"
    },
    "metadata": {
      "type": "object",
      "description": "Additional data about the activity"
    },
    "is_important": {
      "type": "boolean",
      "default": false,
      "description": "Highlight important activities"
    }
  },
  "required": [
    "activity_type",
    "title",
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "email": {
          "$exists": true
        }
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "user_email": "{{user.email}}"
        }
      ]
    },
    "update": false,
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    }
  }
}