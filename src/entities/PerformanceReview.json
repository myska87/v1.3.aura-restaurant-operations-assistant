{
  "name": "PerformanceReview",
  "type": "object",
  "properties": {
    "staff_email": {
      "type": "string",
      "description": "Staff being reviewed"
    },
    "staff_name": {
      "type": "string"
    },
    "review_period": {
      "type": "string",
      "description": "e.g., 2024-01 for January 2024"
    },
    "reviewer_email": {
      "type": "string",
      "description": "Manager conducting review"
    },
    "reviewer_name": {
      "type": "string"
    },
    "punctuality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Score out of 10"
    },
    "cleanliness_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "customer_service_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "teamwork_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "initiative_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "overall_score": {
      "type": "number",
      "description": "Average of all scores"
    },
    "strengths": {
      "type": "string",
      "description": "What they do well"
    },
    "areas_for_improvement": {
      "type": "string",
      "description": "Development areas"
    },
    "goals_set": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Goals for next period"
    },
    "manager_comments": {
      "type": "string"
    },
    "staff_comments": {
      "type": "string",
      "description": "Staff self-reflection"
    },
    "badges_earned": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Performance badges"
    },
    "review_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed",
        "acknowledged"
      ],
      "default": "draft"
    }
  },
  "required": [
    "staff_email",
    "review_period",
    "reviewer_email"
  ]
}