{
  "name": "StaffProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Link to User entity"
    },
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "User's email for reference"
    },
    "user_name": {
      "type": "string",
      "description": "User's full name"
    },
    "position": {
      "type": "string",
      "enum": [
        "manager",
        "chef",
        "line_cook",
        "server",
        "bartender",
        "cleaner",
        "maintenance"
      ],
      "description": "Staff position"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "hire_date": {
      "type": "string",
      "format": "date",
      "description": "Date hired"
    },
    "shift_preference": {
      "type": "string",
      "enum": [
        "morning",
        "afternoon",
        "evening",
        "night",
        "flexible"
      ],
      "description": "Preferred shift timing"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of certifications held"
    },
    "emergency_contact": {
      "type": "string",
      "description": "Emergency contact details"
    },
    "hourly_rate": {
      "type": "number",
      "description": "Hourly pay rate"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether staff member is currently active"
    }
  },
  "required": [
    "user_email",
    "user_name",
    "position"
  ]
}