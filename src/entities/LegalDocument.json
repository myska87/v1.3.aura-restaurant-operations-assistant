{
  "name": "LegalDocument",
  "type": "object",
  "properties": {
    "document_type": {
      "type": "string",
      "enum": [
        "privacy_policy",
        "terms_of_service",
        "data_processing_agreement",
        "cookie_policy",
        "data_retention_policy",
        "security_policy",
        "gdpr_statement"
      ],
      "description": "Type of legal document"
    },
    "version": {
      "type": "string",
      "description": "Document version (e.g., v1.2)"
    },
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "content_html": {
      "type": "string",
      "description": "Full HTML content of document"
    },
    "content_markdown": {
      "type": "string",
      "description": "Markdown version"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "When document becomes effective"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "When document expires"
    },
    "is_current": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the current active version"
    },
    "requires_consent": {
      "type": "boolean",
      "default": false,
      "description": "Whether users must consent to this"
    },
    "created_by": {
      "type": "string",
      "description": "Who created/updated document"
    },
    "reviewed_by_legal": {
      "type": "boolean",
      "default": false,
      "description": "Whether legal team reviewed"
    },
    "legal_reviewer": {
      "type": "string",
      "description": "Legal team member who reviewed"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "change_log": {
      "type": "string",
      "description": "Summary of changes from previous version"
    },
    "previous_version": {
      "type": "string",
      "description": "Link to previous version"
    },
    "pdf_url": {
      "type": "string",
      "description": "PDF download URL"
    },
    "users_notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether existing users were notified"
    },
    "notification_sent_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "document_type",
    "version",
    "title",
    "content_html",
    "effective_date"
  ]
}