{
  "name": "PerformanceMetric",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "description": "Reference to User entity"
    },
    "staff_email": {
      "type": "string",
      "description": "Staff member email"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name"
    },
    "week_number": {
      "type": "number",
      "description": "ISO week number"
    },
    "week_start": {
      "type": "string",
      "format": "date"
    },
    "week_end": {
      "type": "string",
      "format": "date"
    },
    "punctuality_score": {
      "type": "number",
      "description": "0-100 based on on-time arrivals"
    },
    "attendance_rate": {
      "type": "number",
      "description": "% of scheduled shifts attended"
    },
    "task_completion_rate": {
      "type": "number",
      "description": "% of assigned tasks completed"
    },
    "checklist_accuracy": {
      "type": "number",
      "description": "% of checklist items passed"
    },
    "customer_feedback_score": {
      "type": "number",
      "description": "Average customer rating if applicable"
    },
    "manager_rating": {
      "type": "number",
      "description": "Manager's rating 1-5"
    },
    "peer_recognition_count": {
      "type": "number",
      "default": 0,
      "description": "Number of peer recognitions received"
    },
    "total_badges_earned": {
      "type": "number",
      "default": 0
    },
    "total_points": {
      "type": "number",
      "default": 0,
      "description": "Performance points earned"
    },
    "final_score": {
      "type": "number",
      "description": "Weighted average of all metrics (0-100)"
    },
    "performance_tier": {
      "type": "string",
      "enum": [
        "needs_improvement",
        "meets_expectations",
        "exceeds_expectations",
        "exceptional"
      ],
      "description": "Performance tier based on final score"
    },
    "bonus_eligible": {
      "type": "boolean",
      "default": false,
      "description": "Qualifies for performance bonus"
    },
    "bonus_amount": {
      "type": "number",
      "default": 0
    },
    "manager_feedback": {
      "type": "string",
      "description": "Manager's comments"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "staff_email",
    "week_number",
    "week_start",
    "week_end"
  ]
}