        "line_cook",
        "server",
        "bartender",
        "host",
        "cleaner",
        "maintenance",
        "dishwasher"
      ],
      "description": "Staff position"
    },
    "department": {
      "type": "string",
      "enum": [
        "management",
        "kitchen",
        "front_of_house",
        "bar",
        "cleaning",
        "maintenance"
      ],
      "description": "Department"
    },
    "phone": {
      "type": "string",
