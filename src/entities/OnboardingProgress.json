{
  "name": "OnboardingProgress",
  "type": "object",
  "properties": {
    "staff_email": {
      "type": "string",
      "description": "Staff member email"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name"
    },
    "step_id": {
      "type": "string",
      "description": "Reference to OnboardingStep"
    },
    "step_title": {
      "type": "string",
      "description": "Cached step title"
    },
    "step_number": {
      "type": "number",
      "description": "Cached step number"
    },
    "status": {
      "type": "string",
      "enum": [
        "locked",
        "in_progress",
        "completed",
        "failed"
      ],
      "default": "locked"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "video_watched": {
      "type": "boolean",
      "default": false
    },
    "video_watch_percentage": {
      "type": "number",
      "default": 0
    },
    "quiz_score": {
      "type": "number",
      "description": "Score percentage if quiz taken"
    },
    "quiz_passed": {
      "type": "boolean",
      "default": false
    },
    "quiz_attempts": {
      "type": "number",
      "default": 0
    },
    "acknowledged": {
      "type": "boolean",
      "default": false
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "documents_uploaded": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Document IDs uploaded for this step"
    },
    "approved_by": {
      "type": "string",
      "description": "Manager who approved"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or feedback"
    }
  },
  "required": [
    "staff_email",
    "step_id",
    "step_number"
  ]
}