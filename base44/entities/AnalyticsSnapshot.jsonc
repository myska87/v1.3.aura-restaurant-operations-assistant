{
  "name": "AnalyticsSnapshot",
  "type": "object",
  "properties": {
    "snapshot_date": {
      "type": "string",
      "format": "date",
      "description": "Date of this snapshot"
    },
    "period_type": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "daily",
      "description": "Aggregation period"
    },
    "department": {
      "type": "string",
      "enum": [
        "all",
        "kitchen",
        "front_of_house",
        "bar",
        "management",
        "cleaning",
        "maintenance"
      ],
      "default": "all"
    },
    "task_completion_rate": {
      "type": "number",
      "description": "Percentage of tasks completed"
    },
    "quality_score_avg": {
      "type": "number",
      "description": "Average quality audit score"
    },
    "shift_compliance": {
      "type": "number",
      "description": "Percentage of shifts with on-time attendance"
    },
    "inventory_cost_variance": {
      "type": "number",
      "description": "Cost variance percentage"
    },
    "active_alerts": {
      "type": "number",
      "description": "Number of unresolved alerts"
    },
    "sop_completion_rate": {
      "type": "number",
      "description": "Percentage of SOPs completed"
    },
    "checklist_completion_rate": {
      "type": "number",
      "description": "Percentage of checklists completed"
    },
    "attendance_rate": {
      "type": "number",
      "description": "Percentage attendance"
    },
    "total_hours_worked": {
      "type": "number",
      "description": "Total hours worked in period"
    },
    "overtime_hours": {
      "type": "number",
      "description": "Total overtime hours"
    },
    "total_staff": {
      "type": "number",
      "description": "Number of active staff"
    },
    "stock_efficiency": {
      "type": "number",
      "description": "Inventory efficiency score"
    },
    "waste_percentage": {
      "type": "number",
      "description": "Waste as percentage of total stock"
    },
    "customer_feedback_score": {
      "type": "number",
      "description": "Average customer rating if available"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by": {
      "type": "string",
      "default": "system"
    }
  },
  "required": [
    "snapshot_date",
    "period_type",
    "department"
  ]
}