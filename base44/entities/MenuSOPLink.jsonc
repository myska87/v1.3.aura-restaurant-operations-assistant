{
  "name": "MenuSOPLink",
  "type": "object",
  "properties": {
    "menu_item_id": {
      "type": "string",
      "description": "Reference to MenuItem"
    },
    "menu_item_name": {
      "type": "string",
      "description": "Cached menu item name"
    },
    "sop_id": {
      "type": "string",
      "description": "Reference to SOPDocument"
    },
    "sop_title": {
      "type": "string",
      "description": "Cached SOP title"
    },
    "sop_version": {
      "type": "number",
      "description": "SOP version when linked"
    },
    "linked_by": {
      "type": "string",
      "description": "User who created the link"
    },
    "linked_by_name": {
      "type": "string",
      "description": "Name of user who linked"
    },
    "linked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When link was created"
    },
    "auto_update": {
      "type": "boolean",
      "default": true,
      "description": "Whether to auto-update when SOP changes"
    },
    "link_type": {
      "type": "string",
      "enum": [
        "preparation",
        "serving",
        "plating",
        "reference"
      ],
      "default": "preparation",
      "description": "Type of connection"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether link is active"
    }
  },
  "required": [
    "menu_item_id",
    "sop_id",
    "linked_by"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "read": {
      "user_condition": {
        "email": {
          "$exists": true
        }
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    }
  }
}