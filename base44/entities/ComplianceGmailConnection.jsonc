{
  "name": "ComplianceGmailConnection",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who connected Gmail"
    },
    "user_email": {
      "type": "string",
      "description": "User's app email"
    },
    "gmail_account": {
      "type": "string",
      "format": "email",
      "description": "Connected Gmail address"
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "active",
        "disconnected",
        "expired",
        "error"
      ],
      "default": "active"
    },
    "oauth_token_encrypted": {
      "type": "string",
      "description": "Encrypted OAuth access token"
    },
    "oauth_refresh_token_encrypted": {
      "type": "string",
      "description": "Encrypted OAuth refresh token"
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When OAuth token expires"
    },
    "scopes_granted": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Gmail API scopes granted"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "emails_sent_count": {
      "type": "number",
      "default": 0,
      "description": "Total emails sent via this connection"
    },
    "last_error": {
      "type": "string",
      "description": "Last error message"
    },
    "last_error_at": {
      "type": "string",
      "format": "date-time"
    },
    "auto_reconnect_enabled": {
      "type": "boolean",
      "default": true
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Primary email account for organization"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "gmail_account",
    "connection_status",
    "connected_at"
  ]
}