{
  "name": "BridgeEventLog",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique event identifier"
    },
    "source_module": {
      "type": "string",
      "enum": [
        "tasks",
        "workforce",
        "compliance",
        "leafe",
        "inventory",
        "menu",
        "documents",
        "checklists",
        "forms",
        "payroll",
        "other"
      ],
      "description": "Which module triggered the event"
    },
    "event_type": {
      "type": "string",
      "description": "Type of event (task_completed, shift_started, etc.)"
    },
    "reference_id": {
      "type": "string",
      "description": "ID of the record that triggered event"
    },
    "reference_type": {
      "type": "string",
      "description": "Type of record (Task, Shift, Document, etc.)"
    },
    "payload": {
      "type": "object",
      "description": "Event data and context"
    },
    "target_modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which modules should process this event"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "retrying"
      ],
      "default": "pending"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "default": "normal"
    },
    "retry_count": {
      "type": "number",
      "default": 0,
      "description": "Number of retry attempts"
    },
    "error_message": {
      "type": "string",
      "description": "Error details if failed"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When event was processed"
    },
    "processing_duration_ms": {
      "type": "number",
      "description": "Time taken to process in milliseconds"
    },
    "triggered_by_user": {
      "type": "string",
      "description": "User email who triggered event"
    },
    "triggered_by_name": {
      "type": "string",
      "description": "User name who triggered event"
    }
  },
  "required": [
    "source_module",
    "event_type",
    "reference_id",
    "status"
  ]
}