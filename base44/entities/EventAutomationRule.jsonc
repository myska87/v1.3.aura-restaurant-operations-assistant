{
  "name": "EventAutomationRule",
  "type": "object",
  "properties": {
    "rule_name": {
      "type": "string",
      "description": "Name of automation rule"
    },
    "description": {
      "type": "string",
      "description": "What this rule does"
    },
    "trigger_event_type": {
      "type": "string",
      "description": "Event type that triggers this rule"
    },
    "trigger_conditions": {
      "type": "object",
      "description": "Additional conditions to check (e.g., severity=critical)"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "create_task",
        "send_email",
        "create_maintenance_ticket",
        "create_purchase_order",
        "notify_manager",
        "escalate_alert",
        "update_status",
        "create_quality_check",
        "other"
      ],
      "description": "Action to perform when triggered"
    },
    "action_config": {
      "type": "object",
      "description": "Configuration for the action"
    },
    "target_role": {
      "type": "string",
      "description": "Role to assign task/alert to"
    },
    "target_department": {
      "type": "string",
      "description": "Department to notify"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Priority of triggered action"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether rule is currently active"
    },
    "created_by": {
      "type": "string",
      "description": "Admin who created this rule"
    },
    "created_by_name": {
      "type": "string"
    },
    "times_triggered": {
      "type": "number",
      "default": 0,
      "description": "How many times this rule has fired"
    },
    "last_triggered_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time this rule was triggered"
    },
    "cooldown_minutes": {
      "type": "number",
      "default": 0,
      "description": "Minimum minutes between triggers"
    }
  },
  "required": [
    "rule_name",
    "trigger_event_type",
    "action_type",
    "is_active"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}