{
  "name": "ModuleProtectionConfig",
  "type": "object",
  "properties": {
    "module_name": {
      "type": "string",
      "enum": [
        "SOPCore",
        "DocumentCore",
        "TrainingAcademy",
        "EventHub",
        "OperationsCore",
        "QualityCore",
        "InventoryCore",
        "HygieneCore",
        "ComplianceCore",
        "StaffCore",
        "AnalyticsCore",
        "AuraBrain",
        "FormIntelligence"
      ],
      "description": "Name of protected module"
    },
    "protection_level": {
      "type": "string",
      "enum": [
        "locked",
        "warning",
        "monitored"
      ],
      "default": "locked",
      "description": "Level of protection"
    },
    "is_locked": {
      "type": "boolean",
      "default": true,
      "description": "Whether module is locked from changes"
    },
    "version": {
      "type": "string",
      "description": "Current stable version (e.g., v1.0)"
    },
    "status": {
      "type": "string",
      "enum": [
        "healthy",
        "warning",
        "critical",
        "offline"
      ],
      "default": "healthy",
      "description": "Current health status"
    },
    "last_health_check": {
      "type": "string",
      "format": "date-time",
      "description": "Last health check timestamp"
    },
    "critical_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of critical files in this module"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other modules this depends on"
    },
    "locked_by": {
      "type": "string",
      "description": "Who locked this module"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When module was locked"
    },
    "unlock_requires_ticket": {
      "type": "boolean",
      "default": true,
      "description": "Requires feature ticket to unlock"
    },
    "description": {
      "type": "string",
      "description": "Module description and purpose"
    },
    "notes": {
      "type": "string",
      "description": "Protection notes and warnings"
    }
  },
  "required": [
    "module_name",
    "is_locked",
    "version",
    "status"
  ]
}