{
  "name": "MeetingAttendee",
  "type": "object",
  "properties": {
    "meeting_id": {
      "type": "string",
      "description": "Reference to MeetingRecording"
    },
    "meeting_title": {
      "type": "string",
      "description": "Cached meeting title"
    },
    "staff_id": {
      "type": "string",
      "description": "Reference to User"
    },
    "staff_email": {
      "type": "string",
      "description": "Staff email"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff full name"
    },
    "role": {
      "type": "string",
      "description": "Staff position"
    },
    "department": {
      "type": "string",
      "description": "Department"
    },
    "attendance_status": {
      "type": "string",
      "enum": [
        "present",
        "absent",
        "late",
        "left_early"
      ],
      "default": "present",
      "description": "Attendance status"
    },
    "detected_by_voice": {
      "type": "boolean",
      "default": false,
      "description": "Whether presence was detected by voice AI"
    },
    "contribution_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times they spoke (from diarization)"
    },
    "tasks_assigned": {
      "type": "number",
      "default": 0,
      "description": "Number of action items assigned to them"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "description": "When they acknowledged receiving meeting notes"
    },
    "notes": {
      "type": "string",
      "description": "Additional attendee notes"
    }
  },
  "required": [
    "meeting_id",
    "staff_email",
    "staff_name"
  ]
}