{
  "name": "PayrollRecord",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "description": "Reference to User entity"
    },
    "staff_email": {
      "type": "string",
      "description": "Staff member email"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name"
    },
    "role": {
      "type": "string",
      "description": "Position during this period"
    },
    "department": {
      "type": "string",
      "description": "Department"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Payroll period start date"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "Payroll period end date"
    },
    "week_number": {
      "type": "number",
      "description": "ISO week number"
    },
    "total_hours": {
      "type": "number",
      "description": "Total hours worked"
    },
    "regular_hours": {
      "type": "number",
      "description": "Regular hours (within scheduled)"
    },
    "overtime_hours": {
      "type": "number",
      "description": "Overtime hours"
    },
    "night_hours": {
      "type": "number",
      "default": 0,
      "description": "Hours worked during night shift"
    },
    "weekend_hours": {
      "type": "number",
      "default": 0,
      "description": "Hours worked on weekends"
    },
    "total_shifts": {
      "type": "number",
      "description": "Number of shifts worked"
    },
    "late_count": {
      "type": "number",
      "default": 0,
      "description": "Number of late clock-ins"
    },
    "early_departure_count": {
      "type": "number",
      "default": 0
    },
    "base_hourly_rate": {
      "type": "number",
      "description": "Base wage rate used"
    },
    "overtime_rate": {
      "type": "number",
      "description": "Overtime multiplier used"
    },
    "regular_pay": {
      "type": "number",
      "description": "Pay for regular hours"
    },
    "overtime_pay": {
      "type": "number",
      "description": "Pay for overtime hours"
    },
    "night_shift_bonus": {
      "type": "number",
      "default": 0
    },
    "weekend_bonus": {
      "type": "number",
      "default": 0
    },
    "performance_bonus": {
      "type": "number",
      "default": 0,
      "description": "Bonus based on performance score"
    },
    "deductions": {
      "type": "object",
      "properties": {
        "late_penalties": {
          "type": "number"
        },
        "uniform": {
          "type": "number"
        },
        "other": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "Deductions from pay"
    },
    "total_gross_pay": {
      "type": "number",
      "description": "Total before deductions"
    },
    "total_net_pay": {
      "type": "number",
      "description": "Final amount to pay"
    },
    "performance_score": {
      "type": "number",
      "description": "Overall performance score (0-100)"
    },
    "tasks_completed": {
      "type": "number",
      "default": 0
    },
    "tasks_assigned": {
      "type": "number",
      "default": 0
    },
    "task_completion_rate": {
      "type": "number",
      "description": "Percentage of tasks completed"
    },
    "checklists_completed": {
      "type": "number",
      "default": 0
    },
    "checklist_accuracy": {
      "type": "number",
      "description": "Average checklist pass rate"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generated",
        "verified",
        "approved",
        "paid",
        "disputed"
      ],
      "default": "draft",
      "description": "Payroll status"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When report was generated"
    },
    "generated_by": {
      "type": "string",
      "description": "Who generated the report"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by": {
      "type": "string",
      "description": "Manager who verified"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "Manager notes"
    },
    "staff_comments": {
      "type": "string",
      "description": "Staff feedback or disputes"
    }
  },
  "required": [
    "staff_email",
    "period_start",
    "period_end",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "staff_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}