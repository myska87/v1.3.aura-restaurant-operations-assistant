{
  "name": "ModuleHealthLog",
  "type": "object",
  "properties": {
    "module_name": {
      "type": "string",
      "description": "Module being checked"
    },
    "check_type": {
      "type": "string",
      "enum": [
        "startup",
        "scheduled",
        "manual",
        "post_deploy"
      ],
      "default": "scheduled",
      "description": "Type of health check"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "warning",
        "failed",
        "critical"
      ],
      "default": "passed",
      "description": "Health check result"
    },
    "checks_performed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_name": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "critical"
            ]
          }
        }
      },
      "description": "Individual check results"
    },
    "errors_found": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of errors detected"
    },
    "warnings_found": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of warnings"
    },
    "performance_metrics": {
      "type": "object",
      "properties": {
        "load_time_ms": {
          "type": "number"
        },
        "memory_usage_mb": {
          "type": "number"
        },
        "api_response_time_ms": {
          "type": "number"
        }
      }
    },
    "checked_by": {
      "type": "string",
      "description": "User or 'system'"
    },
    "auto_fix_attempted": {
      "type": "boolean",
      "default": false,
      "description": "Whether automatic fix was attempted"
    },
    "fix_successful": {
      "type": "boolean",
      "description": "Whether auto-fix succeeded"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Suggested fixes or improvements"
    }
  },
  "required": [
    "module_name",
    "check_type",
    "status"
  ]
}