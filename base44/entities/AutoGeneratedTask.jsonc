{
  "name": "AutoGeneratedTask",
  "type": "object",
  "properties": {
    "task_name": {
      "type": "string",
      "description": "Name of the task"
    },
    "description": {
      "type": "string",
      "description": "Task description"
    },
    "assigned_to_email": {
      "type": "string",
      "description": "Staff member email"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Staff member name"
    },
    "role": {
      "type": "string",
      "description": "Role this task is for"
    },
    "department": {
      "type": "string",
      "description": "Department"
    },
    "shift_id": {
      "type": "string",
      "description": "Reference to Shift"
    },
    "shift_date": {
      "type": "string",
      "format": "date",
      "description": "Date of shift"
    },
    "linked_responsibility_id": {
      "type": "string",
      "description": "Reference to RoleResponsibility"
    },
    "linked_form_id": {
      "type": "string",
      "description": "Reference to FormTemplate if applicable"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Task priority"
    },
    "estimated_minutes": {
      "type": "number",
      "description": "Estimated time to complete"
    },
    "due_time": {
      "type": "string",
      "description": "Due time (HH:mm)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "overdue",
        "skipped"
      ],
      "default": "pending"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "requires_photo": {
      "type": "boolean",
      "default": false
    },
    "photo_url": {
      "type": "string",
      "description": "Evidence photo"
    },
    "requires_manager_approval": {
      "type": "boolean",
      "default": false
    },
    "approved_by": {
      "type": "string",
      "description": "Manager who approved"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "Completion notes"
    },
    "created_automatically": {
      "type": "boolean",
      "default": true,
      "description": "Was this auto-generated"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "daily"
    }
  },
  "required": [
    "task_name",
    "assigned_to_email",
    "role",
    "shift_id",
    "shift_date",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "assigned_to_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        },
        {
          "assigned_to_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "position": "manager"
          }
        },
        {
          "user_condition": {
            "position": "owner"
          }
        }
      ]
    }
  }
}