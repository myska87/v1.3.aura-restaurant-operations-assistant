{
  "name": "DocumentReview",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Reference to Document"
    },
    "document_title": {
      "type": "string",
      "description": "Cached document title"
    },
    "staff_email": {
      "type": "string",
      "description": "Staff member who viewed"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name"
    },
    "version_viewed": {
      "type": "number",
      "description": "Version number viewed"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time",
      "description": "When document was opened"
    },
    "viewed_duration": {
      "type": "number",
      "description": "Seconds spent viewing"
    },
    "pages_viewed": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Which pages were viewed"
    },
    "completed_reading": {
      "type": "boolean",
      "default": false,
      "description": "Read to the end"
    },
    "acknowledged": {
      "type": "boolean",
      "default": false,
      "description": "Confirmed understanding"
    },
    "signature_url": {
      "type": "string",
      "description": "Digital signature image"
    },
    "acknowledgment_date": {
      "type": "string",
      "format": "date-time",
      "description": "When acknowledged"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address for audit"
    },
    "device_info": {
      "type": "string",
      "description": "Device used"
    }
  },
  "required": [
    "document_id",
    "staff_email",
    "opened_at"
  ]
}